NODE_ENV=development
PORT=4000
MONGODB_URI=mongodb://127.0.0.1:27017/lady3d
JWT_SECRET=replace-with-at-least-32-random-characters
FRONTEND_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
VITE_API_URL=

# Optional initial owner account. Set these locally before npm run seed.
SEED_OWNER_EMAIL=
SEED_OWNER_PASSWORD=
SEED_OWNER_NAME=Business Owner
SEED_OWNER_PHONE=

# Paystack stays disabled until a secret key and public callback URLs are set.
PAYSTACK_SECRET_KEY=
API_PUBLIC_URL=https://your-public-api.example
FRONTEND_PUBLIC_URL=https://your-frontend.example
