NODE_ENV=development
PORT=4000
MONGODB_URI=mongodb://127.0.0.1:27017/lady3d
JWT_SECRET=replace-with-at-least-32-random-characters
FRONTEND_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
VITE_API_URL=

# Optional initial owner account. Set these locally before npm run seed.
SEED_OWNER_EMAIL=
SEED_OWNER_PASSWORD=
SEED_OWNER_NAME=Business Owner
SEED_OWNER_PHONE=

# Hubtel stays disabled until these merchant credentials and public callback URLs are set.
HUBTEL_SANDBOX=true
HUBTEL_API_ID=
HUBTEL_API_KEY=
HUBTEL_COLLECTION_ACCOUNT=
HUBTEL_CALLBACK_URL=https://your-public-api.example/api/payments/hubtel/callback
HUBTEL_RETURN_URL=https://your-frontend.example/#/track
HUBTEL_CANCEL_URL=https://your-frontend.example/#/cart
HUBTEL_CALLBACK_IPS=18.202.122.131,108.129.40.25
